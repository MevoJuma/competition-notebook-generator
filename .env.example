# ==============================================================================
# AI Competition Analysis & Notebook Generation Platform - Environment Config
# ==============================================================================

# Application Core
PROJECT_NAME="AI Competition Analysis & Notebook Generation Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="replace_with_a_secure_random_key_in_production"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/competition_platform"
DATABASE_ECHO=false

# Redis Configuration (Job Queue Broker & State Cache)
REDIS_URL="redis://localhost:6379/0"

# Storage Configuration (Local Paths or S3-compatible)
STORAGE_TYPE="local"
STORAGE_ROOT="./storage"
STORAGE_UPLOAD_DIR="./storage/uploads"
STORAGE_GENERATED_DIR="./storage/generated"

# File Security & Ingestion Limits
MAX_UPLOAD_SIZE_BYTES=524288000       # 500 MB max individual file size
MAX_TOTAL_ARCHIVE_SIZE_BYTES=2147483648 # 2 GB max unpacked size
MAX_ZIP_COMPRESSION_RATIO=10          # Reject archives with >10x expansion ratio

# LLM Engine Configuration (OpenAI Compatible)
# Supports OpenAI, Azure, Gemini (via OpenAI compatibility endpoint), Ollama, vLLM
LLM_API_KEY="your_api_key_here"
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_MODEL="gemini-2.0-flash"
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT_SECONDS=60

# Celery Background Worker Settings
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TASK_TIMEOUT_SECONDS=1800      # 30 minutes max per task
